.actions
            h2.title Redes sociais
            .follow-info
              each link in site.socialLinks
                h2
                  a(href=link.url, title=link.name, target="_blank", rel="noopener noreferrer")
                    span
                      i(class=link.icon)
                    small= link.name
            .follow-btn
              each link in site.projectLinks
                a.button.is-fullwidth(href=link.url)= link.name